{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "[Build] Bump build number",
			"type": "shell",
			"command": "dart run bumper build",
			"options": {
				"cwd": "${workspaceFolder}/re_ucm_app"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "[Build] Windows",
			"type": "shell",
			"command": "dart run bumper build && flutter build windows",
			"options": {
				"cwd": "${workspaceFolder}/re_ucm_app"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "[Build] Linux",
			"type": "shell",
			"command": "dart run bumper build && flutter build linux",
			"options": {
				"cwd": "${workspaceFolder}/re_ucm_app"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "[Build] macOS",
			"type": "shell",
			"command": "dart run bumper build && flutter build macos",
			"options": {
				"cwd": "${workspaceFolder}/re_ucm_app"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "[Build] Android APK (prod, split-per-abi)",
			"type": "shell",
			"command": "dart run bumper build && flutter build apk --split-per-abi && dart run ../.vscode/export_apk.dart --flavor prod",
			"options": {
				"cwd": "${workspaceFolder}/re_ucm_app"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "[Build] Android APK (alpha)",
			"type": "shell",
			"command": "dart run bumper build && flutter build apk --flavor alpha --split-per-abi && dart run ../.vscode/export_apk.dart --flavor alpha",
			"options": {
				"cwd": "${workspaceFolder}/re_ucm_app"
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "[Build Runner]",
			"type": "shell",
			"command": "dart",
			"args": [
				"run",
				"build_runner",
				"build",
				"-d",
				"--workspace",
			],
			"isBackground": false,
			"problemMatcher": "$dart-build_runner",
			"group": "build"
		},
        {
            "label": "build_runner watch",
            "type": "shell",
            "command": "dart",
            "args": [
                "run",
                "build_runner",
                "watch",
                "-d",
				"--workspace",
            ],
            "isBackground": true,
            "problemMatcher": "$dart-build_runner",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
	]
}